{
  "csv": "data/crisismmd_clean.csv",
  "image_root": "dataset/CrisisMMD_v2.0",
  "image_column": "image_path",
  "text_column": "text_clean",
  "label_column": "image_info",
  "all_rows": false,
  "limit": 0,
  "model": "openai/clip-vit-base-patch32",
  "fusions": [
    "token",
    "pooled"
  ],
  "lora_layers": 4,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "d_model": 256,
  "heads": 4,
  "fusion_layers": 2,
  "fusion_dropout": 0.1,
  "no_skip": false,
  "hidden": 512,
  "dropout": 0.2,
  "epochs": 5,
  "batch_size": 32,
  "lr_lora": 0.0001,
  "lr_head": 0.001,
  "weight_decay": 0.01,
  "warmup": 0.1,
  "no_class_weights": false,
  "workers": 8,
  "seeds": 1,
  "seed_start": 0,
  "out_dir": "results/lora_token"
}